#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <errno.h>
#include <string.h>

int main() {
    int count = 0;
    pid_t pid;

    printf("Починаю стрес-тест для ulimit -u...\n");

    while (1) {
        pid = fork();

        if (pid == -1) {
            printf("\n--- Ліміт досягнуто! ---\n");
            printf("Помилка: %s\n", strerror(errno));
            printf("Успішно створено процесів: %d\n", count);
            break;
        } else if (pid == 0) {
            exit(0); 
        } else {
            count++;
            if (count % 100 == 0) {
                printf("Створено %d процесів...\n", count);
            }
        }
    }

    return 0;
}